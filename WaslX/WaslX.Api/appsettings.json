{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Key": "dcl_2026_x7Qm3v_super_secret_signing_key_change_me_in_prod_9aZ8",
    "Issuer": "WaslX",
    "Audience": "WaslXClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "WorkerCount": 5
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=WaslX;Trusted_Connection=True;TrustServerCertificate=True;",
    "HangfireConnection": "Server=.;Database=WaslX_Hangfire;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "MailSettings": {
    "Mail": "",
    "DisplayName": "WaslX",
    "Password": "",
    "Host": "smtp.gmail.com",
    "Port": 587
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:4200"
  }
}
