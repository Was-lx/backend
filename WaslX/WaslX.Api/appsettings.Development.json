{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Classification": {
    "Provider": "Groq",
    "Groq": {
      "ApiKey": "API_KEY_HERE",
      "BaseUrl": "https://api.groq.com/openai/v1/",
      "Model": "llama-3.3-70b-versatile",
      "Temperature": 0.0,
      "MaxTokens": 300,
      "RequestTimeoutSeconds": 8,
      "UseFallbackOnError": true
    }
  },
  "EscalationScoring": {
    "PerformanceWeight": 0.50,
    "ResponseSpeedWeight": 0.25,
    "WorkloadWeight": 0.25,
    "WorkloadTolerance": 2,
    "AvgResponseTimeTargetSeconds": 120
  }
}
